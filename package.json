{
  "name": "better-suncalc",
  "version": "3.0.0",
  "description": "A small TypeScript library for calculating sun/moon positions and phases.",
  "author": "Cameron Garnham",
  "repository": "da2ce7/better-suncalc",
  "homepage": "https://github.com/da2ce7/better-suncalc#readme",
  "bugs": {
    "url": "https://github.com/da2ce7/better-suncalc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "main": "./dist/bundle.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublish": "yarn run test"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "jiti": "^2",
    "mocha": "^11.1.0",
    "prettier": "^3.5.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.24.0"
  },
  "packageManager": "yarn@4.6.0"
}
