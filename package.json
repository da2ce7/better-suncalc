{
	"name": "better-suncalc-ts",
	"version": "3.0.0",
	"description": "A tiny TypeScript library for calculating sun/moon positions and phases.",
	"author": "Vladimir Agafonkin",
	"repository": "da2ce7/suncalc-ts",
	"homepage": "https://github.com/da2ce7/suncalc-ts#readme",
	"bugs": {
		"url": "https://github.com/da2ce7/suncalc-ts/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": "22.x || 24.x"
	},
	"main": "./dist/bundle.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "tsc && webpack --mode development",
		"postbuild": "rm -rf dist/*.js dist/*.map",
		"build:dev": "tsc && webpack --mode development",
		"build:prod": "tsc && webpack --mode production",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:update-snapshot": "jest --updateSnapshot"
	},
	"files": [
		"src/**/*",
		"dist/**/*"
	],
	"keywords": [
		"sun",
		"astronomy",
		"math",
		"calculation",
		"sunrise",
		"sunset",
		"twilight",
		"moon",
		"illumination"
	],
	"devDependencies": {
		"@babel/core": "^7.26.9",
		"@babel/preset-env": "^7.26.9",
		"@babel/preset-typescript": "^7.26.0",
		"@eslint/js": "^9.21.0",
		"@tsconfig/node20": "^20.1.4",
		"@types/babel__core": "^7",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.13.5",
		"@types/webpack": "^5.28.5",
		"babel-jest": "^29.7.0",
		"dotenv": "^16.4.7",
		"eslint": "^9.21.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-define-config": "^2.1.0",
		"globals": "^16.0.0",
		"jest": "^29.7.0",
		"jiti": "^2.4.2",
		"prettier": "^3.5.2",
		"ts-jest": "^29.2.6",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typedoc": "^0.27.8",
		"typescript": "^5.7.3",
		"typescript-eslint": "8.24.1",
		"webpack": "^5.98.0",
		"webpack-cli": "^6.0.1"
	},
	"packageManager": "yarn@4.6.0",
	"dependenciesMeta": {
		"eslint@9.21.0": {
			"unplugged": true
		},
		"prettier@3.5.2": {
			"unplugged": true
		}
	}
}
